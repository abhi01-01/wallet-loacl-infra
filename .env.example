# Database Configuration (application.yml)
SPRING_DATASOURCE_USERNAME=example_user
SPRING_DATASOURCE_PASSWORD=example_password

# Database Configuration (docker-compose.yml)
POSTGRES_DB=example_walletdb
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password

# Google OAuth2
GOOGLE_CLIENT_ID=example-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-google-client-secret

# Email Configuration
BREVO_API_KEY=example-brevo-api-key
BREVO_SENDER_EMAIL=example@example.com
MAIL_SENDER_NAME=Example Wallet Service

# JWT Secret
JWT_SECRET=example-base64-encoded-jwt-secret
JWT_EXPIRATION_ACCESS=900000
JWT_EXPIRATION_REFRESH=604800000

# Runtime datasource and pool tuning
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/example_walletdb
DB_POOL_NAME=WalletServiceHikariPool
DB_POOL_AUTO_COMMIT=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
HIBERNATE_JDBC_FETCH_SIZE=50

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=example-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=example-razorpay-webhook-secret

# API Gateway / Service-to-service Security
GATEWAY_INTERNAL_SECRET=example-gateway-internal-secret
WALLET_SERVICE_URL=http://wallet-service:8081

# Wallet Web Public Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=example-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_example
